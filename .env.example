# LLM_BACKEND may be "ollama" or "groq". Defaults to Ollama unless GROQ_API_KEY is set.
LLM_BACKEND=ollama

# Ollama (local; no API key required)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b

# Groq (cloud; set LLM_BACKEND=groq and add your key to use this backend)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Optional: raises GitHub's unauthenticated rate limit from 60 to 5,000 requests/hour.
GITHUB_TOKEN=
